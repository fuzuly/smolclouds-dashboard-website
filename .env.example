# Copy to .env.local and fill in. Never commit real values.

# Clerk — written by `clerk init`, or copy from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Send signed-out visitors to the console's own sign-in and sign-up pages
# instead of Clerk's hosted ones.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Signs API tokens. The router must have the same value.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SMOLCLOUDS_TOKEN_SECRET=

# Router base URL. Defaults to https://api.smolclouds.com when unset.
SMOLCLOUDS_API_BASE=

# Closed pilot.
# Comma-separated email domains admitted without an invite code.
PILOT_ALLOWED_DOMAINS=
# Comma-separated invite codes.
PILOT_INVITE_CODES=
# "true" admits every signed-in account (demo mode). Anything else keeps the gate.
PILOT_OPEN=
